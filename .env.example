# ─── Rookery 환경 변수 템플릿 ───
# 이 파일을 복사하여 .env 파일을 생성하고 값을 채워 사용하세요.
# cp .env.example .env

# ── 앱 설정 ──────────────────────────────────────────────
DEBUG=false

# ── 서버 설정 ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── FFmpeg 경로 ───────────────────────────────────────────
# Docker: 자동 설치되므로 기본값(ffmpeg) 사용
# Windows .exe: 내장 바이너리 사용 (설정 불필요)
# Linux Native: ffmpeg가 PATH에 있으면 기본값 사용
FFMPEG_PATH=ffmpeg

# ── 녹화 저장 경로 ────────────────────────────────────────
DOWNLOAD_DIR=./recordings

# 분할 저장 경로 사용 여부 (true 시 아래 경로가 적용됨)
SPLIT_DOWNLOAD_DIRS=false
VOD_CHZZK_DIR=
VOD_EXTERNAL_DIR=

# ── 치지직 인증 쿠키 (성인 인증 / 1080p 접근용, 선택사항) ──
NID_AUT=
NID_SES=

# ── 감시 주기 (초, 기본: 60) ─────────────────────────────
MONITOR_INTERVAL=60

# ── 녹화 설정 ─────────────────────────────────────────────
OUTPUT_FORMAT=ts
RECORDING_QUALITY=best
MAX_RECORD_RETRIES=3

# ── VOD 다운로드 설정 ─────────────────────────────────────
VOD_MAX_CONCURRENT=3
VOD_DEFAULT_QUALITY=best
VOD_MAX_SPEED=0
KEEP_DOWNLOAD_PARTS=false
CHZZK_STREAM_MODE=request-timemachine
CHZZK_TIME_MACHINE_OFFSET=0
SAVE_LIVE_PREVIEW=false
LIVE_FILENAME_TEMPLATE=[{download_date}][{name}] {title}

# ── 채팅 아카이빙 ─────────────────────────────────────────
CHAT_ARCHIVE_ENABLED=false

# ── Discord Bot (선택사항) ────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_NOTIFICATION_CHANNEL_ID=

# 봇 명령어(/start, /stop, /rescan 등) 실행 권한.
# 허용할 사용자 ID (쉼표 구분). 비워두면 사용자 제한 없이 채널 조건만 적용된다.
DISCORD_COMMAND_USER_IDS=
# 명령어를 허용할 채널 ID. 비워두면 DISCORD_NOTIFICATION_CHANNEL_ID가 사용된다.
# 위 세 값이 모두 비어 있으면 안전을 위해 모든 명령어가 거부된다.
DISCORD_COMMAND_CHANNEL_ID=

# ── Discord 알림 (선택사항) ───────────────────────────────
# Bot 연결이 끊겼을 때 폴백으로 사용할 Webhook URL.
# Bot 없이 Webhook만 설정해도 알림은 정상 동작한다.
DISCORD_WEBHOOK_URL=

# 전송할 알림 종류. "all" | "none" | 콤마 구분 목록
# 사용 가능: live_detected, recording_started, recording_completed,
#           recording_failed, space_detected, vod_completed, vod_failed,
#           cookie_expired, update_available, system
DISCORD_NOTIFY_EVENTS=all

# 멘션을 붙일 알림 종류 (비우면 멘션 없음)
# 예: DISCORD_MENTION_EVENTS=live_detected,recording_failed
DISCORD_MENTION_EVENTS=

# 멘션 대상: @here | @everyone | <@&역할ID>
DISCORD_MENTION_TARGET=@here

# 큐에서 대기하는 알림의 최대 수명(초). 초과하면 폐기해 뒷북 알림을 막는다.
DISCORD_NOTIFY_TTL=3600
